<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="600" height="600">
  <defs>
    <linearGradient id="bg_photo-05" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2c1e30" />
      <stop offset="100%" stop-color="#7a4e6f" />
    </linearGradient>
    <radialGradient id="glow_photo-05" cx="50%" cy="45%" r="50%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.18" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width="600" height="600" fill="url(#bg_photo-05)" rx="8" />
  <circle cx="300" cy="260" r="160" fill="url(#glow_photo-05)" />

  <!-- Soft Stars -->
  <circle cx="140" cy="120" r="2.5" fill="#ffffff" opacity="0.6" />
  <circle cx="480" cy="150" r="3" fill="#ffffff" opacity="0.7" />
  <circle cx="180" cy="420" r="2" fill="#ffffff" opacity="0.5" />
  <circle cx="450" cy="380" r="2.5" fill="#ffffff" opacity="0.8" />
  <circle cx="300" cy="90" r="2" fill="#ffffff" opacity="0.6" />

  <!-- Emoji Icon -->
  <text x="300" y="275" font-size="80" text-anchor="middle" dominant-baseline="middle">🌧️</text>

  <!-- Title & Subtitle -->
  <text x="300" y="405" font-family="'Caveat', cursive, sans-serif" font-size="32" font-weight="bold" fill="#fff5fa" text-anchor="middle">Rainy Days By The Window</text>
  <text x="300" y="445" font-family="'DM Sans', sans-serif" font-size="14" fill="#dfcde3" text-anchor="middle">&quot;the safest feeling in the world: listening to the rain&quot;</text>
  <text x="300" y="520" font-family="'DM Sans', sans-serif" font-size="11" fill="#ffffff" opacity="0.45" text-anchor="middle" letter-spacing="2">MEMORIES OF US · REPLACE WITH YOUR PHOTO</text>
</svg>